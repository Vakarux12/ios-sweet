+/* a create found no memory: who holds the big surfaces (the first 3 times, then every 500th) */
+static void
+sweet_surface_report_full(void)
+{
+	static uint32_t times;
+	uint32_t big = 0, users = 0, retains = 0;
+	char list[160];
+	size_t at = 0;
+
+	if (times++ >= 3 && times % 500 != 0) {
+		return;
+	}
+	list[0] = 0;
+	IOLockLock(sweet_surface_lock);
+	for (uint32_t id = 1; id < SWEET_SURFACE_MAX_ID; id++) {
+		SweetSurface *s = sweet_surface_table[id];
+		if (s == NULL || s->allocSize < (8u << 20)) {
+			continue;
+		}
+		users += sweet_surface_users[id];
+		retains += s->getRetainCount();
+		if (big++ < 12 && at < sizeof(list)) {
+			at += snprintf(list + at, sizeof(list) - at, " %u:%u/%d", id, sweet_surface_users[id], s->getRetainCount());
+		}
+	}
+	IOLockUnlock(sweet_surface_lock);
+	IOLog("SWEET SURF: no memory %u: %d live, %llu MB wired, gpu holds %d\n", times, sweet_surface_live,
+	    sweet_surface_wired >> 20, sweet_surface_gpu_held);
+	IOLog("SWEET SURF: %u big in the table, users %u retains %u, id:users/retains%s\n", big, users, retains, list);
+}
