+
+/* every 5 s while ios swaps: frames in, frames shown, gpu copy time, cpu load */
+static struct {
+	uint32_t swaps, presents, gpuN;
+	uint64_t gpuUS, gpuMax;
+	host_cpu_load_info_data_t cpu;
+} sweet_perf;
+
+static void
+sweet_perf_log(void)
+{
+	host_cpu_load_info_data_t cpu;
+	mach_msg_type_number_t n = HOST_CPU_LOAD_INFO_COUNT;
+	if (host_statistics((host_t)host_priv_self(), HOST_CPU_LOAD_INFO, (host_info_t)&cpu, &n) != KERN_SUCCESS) {
+		return;
+	}
+	uint32_t t[CPU_STATE_MAX], all = 0;
+	for (int i = 0; i < CPU_STATE_MAX; i++) {
+		t[i] = cpu.cpu_ticks[i] - sweet_perf.cpu.cpu_ticks[i];
+		all += t[i];
+	}
+	bool first = sweet_perf.cpu.cpu_ticks[CPU_STATE_IDLE] == 0;
+	sweet_perf.cpu = cpu;
+	if (!first && sweet_perf.swaps != 0 && all != 0) {
+		IOLog("SWEET PERF: 5 s %u swaps %u shown, gpu avg %llu max %llu us, cpu user %u sys %u idle %u %%\n",
+		    sweet_perf.swaps, sweet_perf.presents, sweet_perf.gpuN ? sweet_perf.gpuUS / sweet_perf.gpuN : 0,
+		    sweet_perf.gpuMax, 100 * t[CPU_STATE_USER] / all, 100 * t[CPU_STATE_SYSTEM] / all,
+		    100 * t[CPU_STATE_IDLE] / all);
+	}
+	sweet_perf.swaps = sweet_perf.presents = sweet_perf.gpuN = 0;
+	sweet_perf.gpuUS = sweet_perf.gpuMax = 0;
+}
