+/*
+ * a71: init, then read the first 16 MiB of the partition and print fnv-1a
+ * hashes to compare with a dd of the same bytes from recovery
+ */
+static void
+sweet_ufs_probe(void)
+{
+	const uint32_t per = BOUNCE_SIZE / UFS_BLOCK;
+	const uint8_t *b;
+	uint32_t h = 2166136261u, h1 = 0;
+	uint8_t magic[4] = { 0 };
+	uint64_t busy = 0, ns;
+	unsigned mib = 0;
+	int error = sweet_ufs_init();
+	if (error) {
+		printf("SWEET UFS: probe init failed (%d)\n", error);
+		return;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	for (; mib < 16 && (mib + 1) * (uint64_t)per <= su.nblocks; mib++) {
+		uint64_t t0 = mach_absolute_time();
+		error = ufs_read_blocks(su.first_block + mib * per, per);
+		busy += mach_absolute_time() - t0;
+		if (error) {
+			break;
+		}
+		for (uint32_t i = 0; i < BOUNCE_SIZE; i++) {
+			h = (h ^ b[i]) * 16777619u;
+		}
+		if (mib == 0) {
+			h1 = h;
+			memcpy(magic, b + 0x400, 4);
+		}
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	absolutetime_to_nanoseconds(busy, &ns);
+	printf("SWEET UFS: probe read %u MiB in %llu ms (err %d), fnv first MiB %08x, all %08x, at 0x400 %02x %02x %02x %02x\n",
+	    mib, ns / NSEC_PER_MSEC, error, h1, h, magic[0], magic[1], magic[2], magic[3]);
+}
+
