+/*
+ * a71 se7 runs gsi-only firmware (no fifo), so i2c goes by hand on
+ * gpio6 sda and gpio7 scl. open drain: latch stays 0, oe pulls the line low
+ */
+#define BB_SDA 6u
+#define BB_SCL 7u
+
+static void
+bb_set(unsigned pin, bool low)
+{
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	touch_wr(st.gpio, off, (touch_rd(st.gpio, off) & ~0x3ffu) | 3u | (low ? 0x200u : 0u));
+	delay(5);
+}
+
+static bool
+bb_get(unsigned pin)
+{
+	return touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & 1u;
+}
+
+/* release scl and wait out clock stretching */
+static bool
+bb_scl_up(void)
+{
+	bb_set(BB_SCL, false);
+	for (unsigned i = 0; i < 2000; ++i) {
+		if (bb_get(BB_SCL)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+bb_bit(bool one, bool *in)
+{
+	bb_set(BB_SDA, !one);
+	if (!bb_scl_up()) {
+		return false;
+	}
+	if (in) {
+		*in = bb_get(BB_SDA);
+	}
+	bb_set(BB_SCL, true);
+	return true;
+}
+
+static int
+bb_out(uint8_t b)
+{
+	bool nack = true;
+	for (int i = 7; i >= 0; --i) {
+		if (!bb_bit((b >> i) & 1u, NULL)) {
+			return ETIMEDOUT;
+		}
+	}
+	if (!bb_bit(true, &nack)) {
+		return ETIMEDOUT;
+	}
+	return nack ? ENXIO : 0;
+}
+
+static int
+bb_in(uint8_t *b, bool more)
+{
+	bool v = false;
+	*b = 0;
+	for (int i = 0; i < 8; ++i) {
+		if (!bb_bit(true, &v)) {
+			return ETIMEDOUT;
+		}
+		*b = (uint8_t)(*b << 1 | v);
+	}
+	return bb_bit(!more, NULL) ? 0 : ETIMEDOUT; /* ack all but the last byte */
+}
+
+static void
+bb_stop(void)
+{
+	bb_set(BB_SDA, true);
+	(void)bb_scl_up();
+	bb_set(BB_SDA, false);
+}
+
+/* stretch keeps the bus for a repeated start, like the se7 path */
+static int
+touch_bb_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	bb_set(BB_SDA, false);
+	if (!bb_scl_up()) {
+		return ETIMEDOUT;
+	}
+	bb_set(BB_SDA, true);
+	bb_set(BB_SCL, true);
+	int err = bb_out((uint8_t)(addr << 1 | (nr ? 1u : 0u)));
+	for (unsigned i = 0; i < nt && !err; ++i) {
+		err = bb_out(tx[i]);
+	}
+	for (unsigned i = 0; i < nr && !err; ++i) {
+		err = bb_in(&rx[i], i + 1 < nr);
+	}
+	if (err || !stretch) {
+		bb_stop();
+	}
+	return err;
+}
+
 static bool
