@@ -583,6 +583,24 @@ static const struct cdevsw sweet_ufs_cdevsw = {
 	.d_type       = D_DISK,
 };
 
+/* also called by IOFindBSDRoot for a non ufs root, so only once */
+void sweet_input_start(void);
+
+void
+sweet_input_start(void)
+{
+	static bool started;
+
+	if (started) {
+		return;
+	}
+	started = true;
+	/* Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp). */
+	sweet_keys_init();
+	sweet_touch_init();
+	sweet_usb_probe();
+}
+
 static int
 sweet_ufs_init(void)
 {
@@ -656,10 +674,7 @@ sweet_ufs_init(void)
 	    su.writable ? "read-write" : "read-only", su.dma_pa);
 	sweet_log_start();
 	sweet_sample_start();
