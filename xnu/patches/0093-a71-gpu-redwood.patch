@@ -0,0 +1,677 @@
+/*
+ * a71 Adreno 618, the hardware under SweetFramebuffer's present copies and
+ * RedwoodGPU.cpp (msm drm for Mesa freedreno, boot-arg gpu=1).
+ *
+ * The shim (shim/gpu.c, a71gpu=4) leaves the GPU running: GMU, zap shader,
+ * CP out of secure mode, ring idle. Nothing here powers or resets it, both
+ * users share the shim's ring under one lock and one fence. Everything lives
+ * in low RAM that XNU does not own, at 0xf0000000:
+ *   +0x180000  ring, 32 KB (GPU VA 0x60180000)
+ *   +0x1c0000  scratch (GPU VA 0x601c0000), +0x40 handoff, +0x90 CCU flush
+ *              timestamp, +0xa0 fence
+ *   +0x200000  SMMU L1 (T0SZ 32, 4 GB), context bank 0 shares it with the
+ *              GMU's bank 1
+ *   +0x203000  present slots L2 (L1[3], GPU VA 0xc0000000), L3s at +0x400000
+ *   +0x500000  RedwoodGPU L2 (L1[0]), L3s at +0x501000, one per 2 MB
+ * The panel memory is mapped 1:1 by the shim (L1[2]). Page table walks are
+ * non-cacheable and this window is device memory here, so no cache upkeep.
+ */
+#include "SweetSurface.h"
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+#include <kern/clock.h>
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern "C" void CleanPoC_DcacheRegion(vm_offset_t va, size_t length);
+extern "C" void FlushPoC_DcacheRegion(vm_offset_t va, size_t length);
+
+extern "C" {
+bool redwood_gpu_ready(void);
+bool redwood_gpu_identity(void);
+uint64_t topaz_gpu_pool_alloc(uint64_t size, void **va);
+void topaz_gpu_pool_free(uint64_t pa, uint64_t size);
+IOMemoryDescriptor *topaz_gpu_pool_md(uint64_t pa, uint64_t size);
+bool topaz_gpu_midmem(void);
+bool redwood_gpu_parameter(uint32_t which, uint64_t *value);
+uint64_t redwood_gpu_address(uint64_t size);
+void redwood_gpu_address_free(uint64_t address, uint64_t size);
+bool redwood_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+void redwood_gpu_mapped(void);
+void redwood_gpu_unmap(uint64_t address, uint64_t size);
+void redwood_gpu_to_memory(void *start, uint64_t size);
+uint32_t redwood_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+bool redwood_gpu_done(uint32_t fence);
+uint32_t redwood_gpu_last(void);
+void redwood_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7]);
+void redwood_gpu_report(const char *why);
+void redwood_gpu_stop(void);
+void redwood_tl(const char *format, ...) __printflike(1, 2);
+void RedwoodGPUStart(void);
+uint32_t gpu_log;
+}
+
+#define A71GPU_RAM_PA           0xf0000000ULL
+#define A71GPU_RAM_SIZE         0x704000
+#define A71GPU_RING             0x180000
+#define A71GPU_RING_DW          8192
+#define A71GPU_SCR              0x1c0000
+#define A71GPU_SCR_VA           0x601c0000u
+#define A71GPU_READY_MAGIC      0x47505534u     /* written by the shim at scratch + 0x40 */
+#define A71GPU_FENCE            0xa0            /* scratch offset */
+#define A71GPU_L1               0x200000
+#define A71GPU_L2S              0x203000
+#define A71GPU_L3               0x400000
+#define A71GPU_SLOTS            4
+#define A71GPU_SLOT_VA          0xc0000000u
+#define A71GPU_SLOT_SIZE        0x1000000u
+#define A71GPU_UL2              0x500000
+#define A71GPU_UL3              0x501000
+#define A71GPU_VA_START         0x01000000ULL   /* above gmem at 0x100000 */
+#define A71GPU_VA_END           0x40000000ULL
+#define A71GPU_PTE              (1u << 10 | 2u << 8 | 1u << 6)  /* af, outer shareable, rw, attr 0 */
+#define A71GPU_PTE_RO           (1u << 7)
+#define A71GPU_GMEM_BASE        0x100000
+#define A71GPU_GMEM_SIZE        0x80000
+
+static struct {
+	bool                  ready;            /* the handoff worked */
+	bool                  present;          /* present copies still go to the gpu */
+	bool                  redwood;          /* RedwoodGPU may submit */
+	bool                  dirty;            /* page tables changed, tlb not flushed */
+	volatile uint32_t    *regs;
+	volatile uint32_t    *cb0;
+	uintptr_t             ram;
+	IOLock               *lock;             /* ring, seqno, tlb */
+	uint32_t              wptr, seqno, next, hbb;
+	uint64_t              presents;
+	IOMemoryDescriptor   *slotMem[A71GPU_SLOTS];
+	addr64_t              slotPA[A71GPU_SLOTS];
+	uint32_t              slotPages[A71GPU_SLOTS];
+} a71gpu;
+
+static struct { uint64_t start, size; } a71gpu_va_free[1024];
+static unsigned a71gpu_va_count;
+
+static uint32_t
+a71gpu_parity(uint32_t v)
+{
+	v ^= v >> 16;
+	v ^= v >> 8;
+	v ^= v >> 4;
+	return 0x9669 >> (v & 0xf) & 1;
+}
+
+static void
+a71gpu_out(uint32_t v)
+{
+	((volatile uint32_t *)(a71gpu.ram + A71GPU_RING))[a71gpu.wptr++ & (A71GPU_RING_DW - 1)] = v;
+}
+
+static void
+a71gpu_pkt7(uint32_t op, uint32_t cnt)
+{
+	a71gpu_out(0x70000000u | cnt | a71gpu_parity(cnt) << 15 | op << 16 | a71gpu_parity(op) << 23);
+}
+
+static void
+a71gpu_pkt4(uint32_t reg, uint32_t cnt)
+{
+	a71gpu_out(0x40000000u | cnt | a71gpu_parity(cnt) << 7 | reg << 8 | a71gpu_parity(reg) << 27);
+}
+
+static void
+a71gpu_reg(uint32_t reg, uint32_t v)
+{
+	a71gpu_pkt4(reg, 1);
+	a71gpu_out(v);
+}
+
+/* CP_EVENT_WRITE, the _TS events also write a timestamp to scratch + 0x90 */
+static void
+a71gpu_event(uint32_t ev, bool ts)
+{
+	a71gpu_pkt7(0x46, ts ? 4 : 1);
+	a71gpu_out(ev | (ts ? 1u << 30 : 0));
+	if (ts) {
+		a71gpu_out(A71GPU_SCR_VA + 0x90);
+		a71gpu_out(0);
+		a71gpu_out(ev);
+	}
+}
+
+static volatile uint32_t *
+a71gpu_scr(uint32_t off)
+{
+	return (volatile uint32_t *)(a71gpu.ram + A71GPU_SCR + off);
+}
+
+/* lock held, waits up to 2 s for the cp to make room */
+static bool
+a71gpu_room(uint32_t need)
+{
+	for (int i = 0; ((a71gpu.regs[0x806] - a71gpu.wptr - 1) & (A71GPU_RING_DW - 1)) < need; i++) {
+		if (i == 20000) {
+			return false;
+		}
+		IODelay(100);
+	}
+	return true;
+}
+
+/* lock held, CACHE_FLUSH_TS without the timestamp bit writes the seqno */
+static uint32_t
+a71gpu_fence(void)
+{
+	if (++a71gpu.seqno == 0) {
+		a71gpu.seqno = 1;
+	}
+	a71gpu_pkt7(0x46, 4);
+	a71gpu_out(4);
+	a71gpu_out(A71GPU_SCR_VA + A71GPU_FENCE);
+	a71gpu_out(0);
+	a71gpu_out(a71gpu.seqno);
+	return a71gpu.seqno;
+}
+
+static void
+a71gpu_kick(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a71gpu.regs[0x807] = a71gpu.wptr & (A71GPU_RING_DW - 1);
+}
+
+/* context bank 0 tlb invalidate all, then sync */
+static bool
+a71gpu_tlbi(void)
+{
+	bool ok = false;
+	IOLockLock(a71gpu.lock);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a71gpu.cb0[0x618 / 4] = 0;
+	a71gpu.cb0[0x7f0 / 4] = 0;
+	for (int i = 0; i < 1000 && !ok; i++) {
+		ok = !(a71gpu.cb0[0x7f4 / 4] & 1);
+		if (!ok) {
+			IODelay(1);
+		}
+	}
+	IOLockUnlock(a71gpu.lock);
+	return ok;
+}
+
+/*
+ * The shim's hw init leaves out what 3D needs: perf counters (Mesa's
+ * queries) and the UBWC bank bit, programmed here to what freedreno is told
+ * (Linux a6xx_set_ubwc_config, a618 swizzle 6).
+ */
+static void
+a71gpu_hw_init(void)
+{
+	uint32_t hbb = a71gpu.hbb - 13, lo = hbb & 3, hi = hbb >> 2;
+	a71gpu.regs[0x500] = 1;                         /* RBBM_PERFCTR_CNTL */
+	a71gpu.regs[0x8d0] = 0;                         /* CP_PERFCTR_CP_SEL0, always count */
+	a71gpu.regs[0x8e08] = hi << 10 | lo << 1;       /* RB_NC_MODE_CNTL */
+	a71gpu.regs[0xb604] = hi << 4 | lo << 1;        /* TPL1_NC_MODE_CNTL */
+	a71gpu.regs[0xae02] = hi << 10 | lo << 1;       /* SP_NC_MODE_CNTL */
+	a71gpu.regs[0xe01] = lo << 21;                  /* UCHE_MODE_CNTL */
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+bool
+a71gpu_init(void)
+{
+	int mode = 0;
+	if (!PE_parse_boot_argn("a71gpu", &mode, sizeof(mode)) || mode != 4) {
+		return false;
+	}
+	a71gpu.ram = ml_io_map(A71GPU_RAM_PA, A71GPU_RAM_SIZE);
+	a71gpu.regs = (volatile uint32_t *)ml_io_map(0x05000000, 0x10000);
+	a71gpu.cb0 = (volatile uint32_t *)ml_io_map(0x05048000, 0x1000);
+	a71gpu.lock = IOLockAlloc();
+	if (a71gpu.ram == 0 || a71gpu.regs == NULL || a71gpu.cb0 == NULL || a71gpu.lock == NULL) {
+		IOLog("SWEET GPU: no mappings\n");
+		return false;
+	}
+	volatile uint32_t *scr = a71gpu_scr(0);
+	uint32_t rptr = a71gpu.regs[0x806], wptr = a71gpu.regs[0x807];
+	IOLog("SWEET GPU: handoff 0x%x wptr %u/%u rptr %u rbbm 0x%x\n", scr[0x10], scr[0x11],
+	    wptr, rptr, a71gpu.regs[0x210]);
+	if (scr[0x10] != A71GPU_READY_MAGIC || scr[0x11] != wptr || rptr != wptr) {
+		return false;
+	}
+	volatile uint64_t *l1 = (volatile uint64_t *)(a71gpu.ram + A71GPU_L1);
+	/* gpu va 0xc0000000 (l1[3]) -> surface l2 -> one l3 table per 2 mb */
+	volatile uint64_t *l2 = (volatile uint64_t *)(a71gpu.ram + A71GPU_L2S);
+	for (uint32_t i = 0; i < 512; i++) {
+		l2[i] = i < A71GPU_SLOTS * 8 ? (A71GPU_RAM_PA + A71GPU_L3 + 0x1000 * i) | 3 : 0;
+	}
+	volatile uint64_t *l3 = (volatile uint64_t *)(a71gpu.ram + A71GPU_L3);
+	for (uint32_t i = 0; i < A71GPU_SLOTS * 8 * 512; i++) {
+		l3[i] = 0;
+	}
+	l1[A71GPU_SLOT_VA >> 30] = (A71GPU_RAM_PA + A71GPU_L2S) | 3;
+	/* gpu va 0..1 gb (l1[0]) for RedwoodGPU, l3 tables cleared on first use */
+	volatile uint64_t *ul2 = (volatile uint64_t *)(a71gpu.ram + A71GPU_UL2);
+	for (uint32_t i = 0; i < 512; i++) {
+		ul2[i] = 0;
+	}
+	l1[0] = (A71GPU_RAM_PA + A71GPU_UL2) | 3;
+	*a71gpu_scr(A71GPU_FENCE) = 0;
+	a71gpu.wptr = wptr;
+	a71gpu.seqno = 0;
+	a71gpu.hbb = 14;
+	PE_parse_boot_argn("gpu_hbb", &a71gpu.hbb, sizeof(a71gpu.hbb));
+	if (a71gpu.hbb < 13 || a71gpu.hbb > 16) {
+		a71gpu.hbb = 14;
+	}
+	PE_parse_boot_argn("gpu_log", &gpu_log, sizeof(gpu_log));
+	a71gpu_hw_init();
+	if (!a71gpu_tlbi()) {
+		IOLog("SWEET GPU: tlb sync timeout\n");
+		return false;
+	}
+	a71gpu.ready = a71gpu.present = true;
+
+	uint32_t on = 0;
+	if (PE_parse_boot_argn("gpu", &on, sizeof(on)) && on != 0) {
+		a71gpu_va_count = 0;
+		redwood_gpu_address_free(A71GPU_VA_START, A71GPU_VA_END - A71GPU_VA_START);
+		a71gpu.redwood = true;
+		RedwoodGPUStart();
+		IOLog("SWEET GPU: Adreno 618 shared with RedwoodGPU, hbb %u\n", a71gpu.hbb);
+	}
+	return true;
+}
+
+/* gpu va of the surface memory, mapped page by page into a slot on first use */
+static uint32_t
+a71gpu_map(IOMemoryDescriptor *mem)
+{
+	IOByteCount len = mem->getLength();
+	addr64_t pa0 = mem->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+	if (len == 0 || len > A71GPU_SLOT_SIZE || pa0 == 0) {
+		return 0;
+	}
+	for (uint32_t k = 0; k < A71GPU_SLOTS; k++) {
+		if (a71gpu.slotMem[k] == mem && a71gpu.slotPA[k] == pa0) {
+			return A71GPU_SLOT_VA + k * A71GPU_SLOT_SIZE;
+		}
+	}
+	uint32_t k = a71gpu.next++ % A71GPU_SLOTS;
+	volatile uint64_t *l3 = (volatile uint64_t *)(a71gpu.ram + A71GPU_L3 + (uint64_t)k * 8 * 0x1000);
+	uint32_t pages = (uint32_t)((len + 0xfff) >> 12);
+	OSSafeReleaseNULL(a71gpu.slotMem[k]);
+	for (IOByteCount off = 0; off < len;) {
+		IOByteCount seg = 0;
+		addr64_t pa = mem->getPhysicalSegment(off, &seg, kIOMemoryMapperNone);
+		if (pa == 0 || seg == 0 || ((pa | off) & 0xfff)) {
+			a71gpu.slotPages[k] = 8 * 512;  /* clear it all next time */
+			return 0;
+		}
+		for (IOByteCount o = 0; o < seg && off + o < len; o += 0x1000) {
+			l3[(off + o) >> 12] = (pa + o) | A71GPU_PTE | 3;
+		}
+		off += seg;
+	}
+	for (uint32_t i = pages; i < a71gpu.slotPages[k]; i++) {
+		l3[i] = 0;
+	}
+	a71gpu.slotPages[k] = pages;
+	if (!a71gpu_tlbi()) {
+		IOLog("SWEET GPU: tlb sync timeout\n");
+		a71gpu.present = false;
+		return 0;
+	}
+	mem->retain();
+	a71gpu.slotMem[k] = mem;
+	a71gpu.slotPA[k] = pa0;
+	return A71GPU_SLOT_VA + k * A71GPU_SLOT_SIZE;
+}
+
+/* one 2d engine copy, b8g8r8a8 linear both sides (any 32-bit format copies as is) */
+static void
+a71gpu_blit(uint32_t src, uint32_t spitch, uint32_t sw, uint32_t sh, uint32_t sx,
+    uint32_t dst, uint32_t dpitch, uint32_t dx, uint32_t w, uint32_t h)
+{
+	uint32_t cntl = 0xfu << 20 | 0x30 << 8 | 0x10u << 24;
+	a71gpu_pkt4(0x8401, 4);         /* GRAS_2D_SRC_TL_X .. BR_Y */
+	a71gpu_out(sx << 8);
+	a71gpu_out((sx + w - 1) << 8);
+	a71gpu_out(0);
+	a71gpu_out((h - 1) << 8);
+	a71gpu_reg(0x8405, dx);         /* GRAS_2D_DST_TL, BR */
+	a71gpu_reg(0x8406, (h - 1) << 16 | (dx + w - 1));
+	a71gpu_reg(0x8c00, cntl);       /* RB_2D_BLIT_CNTL */
+	a71gpu_reg(0x8400, cntl);       /* GRAS_2D_BLIT_CNTL */
+	a71gpu_reg(0xacc0, 0xf << 12 | 0x30 << 3);      /* SP_2D_DST_FORMAT */
+	a71gpu_reg(0x8c01, 0);
+	a71gpu_pkt4(0xb4c0, 5);         /* SP_PS_2D_SRC_INFO, SIZE, address, PITCH */
+	a71gpu_out(0x30 | 1 << 10 | 1 << 20 | 1 << 22);
+	a71gpu_out(sh << 15 | sw);
+	a71gpu_out(src);
+	a71gpu_out(0);
+	a71gpu_out(spitch >> 6 << 9);
+	a71gpu_pkt4(0x8c17, 4);         /* RB_2D_DST_INFO, address, PITCH */
+	a71gpu_out(0x30 | 1 << 10);
+	a71gpu_out(dst);
+	a71gpu_out(0);
+	a71gpu_out(dpitch >> 6);
+	a71gpu_pkt7(0x26, 0);           /* CP_WAIT_FOR_IDLE */
+	a71gpu_reg(0x8e04, 0x04100000); /* RB_DBG_ECO_CNTL, a618 blit value */
+	a71gpu_pkt7(0x2c, 1);           /* CP_BLIT BLIT_OP_SCALE */
+	a71gpu_out(3);
+	a71gpu_pkt7(0x26, 0);
+	a71gpu_reg(0x8e04, 0);
+}
+
+/*
+ * Panel rows dy.. from surface rows sy.., false means use the cpu copy. The
+ * panel pitch (4320) is not a multiple of 64, so every copy is two blits
+ * with doubled pitches (even and odd rows). Waits for the copy, *us is how
+ * long that took with the cache clean.
+ */
+bool
+a71gpu_present(SweetSurface *s, uintptr_t src, int32_t sx, int32_t sy, int32_t dx, int32_t dy,
+    int32_t w, int32_t h, uint64_t fb, uint32_t fbPitch, uint64_t *us)
+{
+	uint32_t bpr = s->bytesPerRow;
+	if (!a71gpu.present || (bpr & 31) || (fbPitch & 31) || (s->offset & 15) || (fb & 63) ||
+	    fb >= 0x100000000ULL || sx + w > 0x4000 || dx + w + 16 > 0x4000) {
+		return false;
+	}
+	uint32_t va = a71gpu_map(s->memory);
+	if (va == 0) {
+		return false;
+	}
+	uint64_t t0 = mach_absolute_time();
+	CleanPoC_DcacheRegion(src + s->offset + (uint64_t)sy * bpr, (size_t)(h - 1) * bpr + (size_t)(sx + w) * 4);
+
+	IOLockLock(a71gpu.lock);
+	if (!a71gpu_room(256)) {
+		IOLockUnlock(a71gpu.lock);
+		return false;
+	}
+	/* ccu and uche invalidate (the surface changed), ccu sysmem layout, bypass mode */
+	a71gpu_event(25, false);
+	a71gpu_event(24, false);
+	a71gpu_event(49, false);
+	a71gpu_pkt7(0x26, 0);
+	a71gpu_reg(0x8e07, 0x10000 >> 12 << 23);
+	a71gpu_pkt7(0x65, 1);
+	a71gpu_out(1);
+	for (int32_t j = 0; j < 2 && j < h; j++) {
+		uint64_t d = fb + (uint64_t)(dy + j) * fbPitch;
+		uint32_t skew = (uint32_t)(d & 63);
+		uint32_t n = (uint32_t)(h - j + 1) / 2;
+		a71gpu_blit(va + s->offset + (uint32_t)(sy + j) * bpr, 2 * bpr, (uint32_t)(sx + w), n, (uint32_t)sx,
+		    (uint32_t)(d - skew), 2 * fbPitch, (uint32_t)dx + skew / 4, (uint32_t)w, n);
+	}
+	a71gpu_event(29, true);         /* PC_CCU_FLUSH_COLOR_TS */
+	a71gpu_pkt7(0x26, 0);
+	uint32_t fence = a71gpu_fence();
+	a71gpu_kick();
+	IOLockUnlock(a71gpu.lock);
+
+	/* RedwoodGPU work queued before this one counts too */
+	for (int i = 0; !redwood_gpu_done(fence); i++) {
+		if (i == 250) {
+			IOLog("SWEET GPU: copy timeout, cpu copies from now on\n");
+			redwood_gpu_report("present");
+			a71gpu.present = false;
+			return false;
+		}
+		IOSleep(1);
+	}
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	*us = ns / 1000;
+	if (a71gpu.presents++ % 1000 == 0) {
+		IOLog("SWEET GPU: present %llu took %llu us (clean, copy, wait)\n", a71gpu.presents, *us);
+	}
+	return true;
+}
