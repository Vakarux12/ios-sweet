+
+void
+redwood_gpu_report(const char *why)
+{
+	volatile uint32_t *r = a71gpu.regs, *cb = a71gpu.cb0;
+	IOLog("SWEET GPU: %s: fence %u done %u rptr %u wptr %u rbbm 0x%x hwfault 0x%x ib1 0x%x%08x rem %u\n", why,
+	    a71gpu.seqno, *a71gpu_scr(A71GPU_FENCE), r[0x806], a71gpu.wptr & (A71GPU_RING_DW - 1), r[0x210], r[0x821],
+	    r[0x929], r[0x928], r[0x92a]);
+	IOLog("SWEET GPU: %s: smmu fsr 0x%x far 0x%x%08x fsynr0 0x%x\n", why, cb[0x58 / 4], cb[0x64 / 4], cb[0x60 / 4],
+	    cb[0x68 / 4]);
+}
