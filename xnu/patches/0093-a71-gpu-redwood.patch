+/*
+ * topaz (after darwin-redwood applog, PRIVATE). Boot-arg applog=1: standard output and error
+ * that launchd opens on /dev/null go to the console (and so into the kernel log). Programs
+ * whose file names begin with one of applog_name=NAME[,NAME...] also get OS_ACTIVITY_DT_MODE,
+ * which makes os_log write to standard error; applog=2 gives it to every program (slow).
+ */
+static TUNABLE(uint32_t, exec_applog, "applog", 0);
+static TUNABLE_STR(exec_applog_name, 128, "applog_name", "");
+
+static bool
+exec_applog_oslog(struct image_params *imgp)
+{
+	const char *name, *p = exec_applog_name;
+
+	if (exec_applog >= 2) {
+		return true;
+	}
+	/* (applog_name works on its own too: with sweetnull=NAMES the kernel log gets what they write) */
+	if (*p == 0 || imgp->ip_ndp == NULL) {
+		return false;
+	}
+	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	while (*p != 0) {
+		const char *word = p;
+		while (*p != 0 && *p != ',') {
+			p++;
+		}
+		if (p != word && (size_t)(p - word) <= imgp->ip_ndp->ni_cnd.cn_namelen &&
+		    strncmp(word, name, (size_t)(p - word)) == 0) {
+			return true;
+		}
+		if (*p == ',') {
+			p++;
+		}
+	}
+	return false;
+}
+
+static const char *
+exec_applog_path(int fd, const char *path)
+{
+	if (exec_applog && (fd == 1 || fd == 2) && strcmp(path, "/dev/null") == 0) {
+		return "/dev/console";
+	}
+	return path;
+}
