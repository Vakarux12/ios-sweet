+
+bool
+redwood_gpu_parameter(uint32_t which, uint64_t *value)
+{
+	switch (which) {
+	case 0x01: *value = 618; return true;                   /* GPU_ID */
+	case 0x02: *value = A71GPU_GMEM_SIZE; return true;      /* GMEM_SIZE */
+	case 0x03: *value = 0x06010800; return true;            /* CHIP_ID */
+	case 0x04: *value = 565000000; return true;             /* MAX_FREQ, the shim's dcvs vote */
+	case 0x05:                                              /* TIMESTAMP, CP always on counter */
+		*value = (uint64_t)a71gpu.regs[0x981] << 32 | a71gpu.regs[0x980];
+		return true;
+	case 0x06: *value = A71GPU_GMEM_BASE; return true;      /* GMEM_BASE */
+	case 0x07: *value = 1; return true;                     /* PRIORITIES */
+	case 0x08: case 0x09: case 0x0a: case 0x11:             /* PP_PGTABLE FAULTS SUSPENDS RAYTRACING */
+		*value = 0;
+		return true;
+	case 0x10: *value = a71gpu.hbb; return true;            /* HIGHEST_BANK_BIT */
+	case 0x12: *value = 6; return true;                     /* UBWC_SWIZZLE */
+	case 0x13: *value = 0; return true;                     /* MACROTILE_MODE */
+	default:
+		return false;                                   /* VA_START/VA_SIZE: addresses are ours to give */
+	}
+}
+
+/* 64 kb granules of gpu va, first fit */
+uint64_t
+redwood_gpu_address(uint64_t size)
+{
+	size = (size + 0xffff) & ~0xffffull;
+	for (unsigned i = 0; i < a71gpu_va_count; i++) {
+		if (a71gpu_va_free[i].size >= size) {
+			uint64_t address = a71gpu_va_free[i].start;
+			a71gpu_va_free[i].start += size;
+			a71gpu_va_free[i].size -= size;
+			if (a71gpu_va_free[i].size == 0) {
+				memmove(&a71gpu_va_free[i], &a71gpu_va_free[i + 1], (--a71gpu_va_count - i) * sizeof(a71gpu_va_free[0]));
+			}
+			return address;
+		}
+	}
+	return 0;
+}
+
+void
+redwood_gpu_address_free(uint64_t address, uint64_t size)
+{
+	unsigned at;
+
+	size = (size + 0xffff) & ~0xffffull;
+	for (at = 0; at < a71gpu_va_count && a71gpu_va_free[at].start < address; at++) {
+	}
+	if (at > 0 && a71gpu_va_free[at - 1].start + a71gpu_va_free[at - 1].size == address) {
+		a71gpu_va_free[at - 1].size += size;
+		if (at < a71gpu_va_count && address + size == a71gpu_va_free[at].start) {
+			a71gpu_va_free[at - 1].size += a71gpu_va_free[at].size;
+			memmove(&a71gpu_va_free[at], &a71gpu_va_free[at + 1], (--a71gpu_va_count - at) * sizeof(a71gpu_va_free[0]));
+		}
+	} else if (at < a71gpu_va_count && address + size == a71gpu_va_free[at].start) {
+		a71gpu_va_free[at].start = address;
+		a71gpu_va_free[at].size += size;
+	} else if (a71gpu_va_count < sizeof(a71gpu_va_free) / sizeof(a71gpu_va_free[0])) {
+		memmove(&a71gpu_va_free[at + 1], &a71gpu_va_free[at], (a71gpu_va_count++ - at) * sizeof(a71gpu_va_free[0]));
+		a71gpu_va_free[at].start = address;
+		a71gpu_va_free[at].size = size;
+	}
+}
+
+/* l3 table of the 2 mb around a gpu va, NULL outside l1[0] or when not there yet */
+static volatile uint64_t *
+a71gpu_l3(uint64_t address, bool create)
+{
+	if (address < A71GPU_VA_START || address >= A71GPU_VA_END) {
+		return NULL;
+	}
+	uint32_t i2 = (uint32_t)(address >> 21);
+	volatile uint64_t *l2 = (volatile uint64_t *)(a71gpu.ram + A71GPU_UL2);
+	volatile uint64_t *l3 = (volatile uint64_t *)(a71gpu.ram + A71GPU_UL3 + 0x1000 * (uint64_t)i2);
+	if (l2[i2] == 0) {
+		if (!create) {
+			return NULL;
+		}
+		for (uint32_t i = 0; i < 512; i++) {
+			l3[i] = 0;
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		l2[i2] = (A71GPU_RAM_PA + A71GPU_UL3 + 0x1000 * (uint64_t)i2) | 3;
+	}
+	return l3;
+}
+
+bool
+redwood_gpu_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	volatile uint64_t *l3 = a71gpu_l3(address, true);
+	if (l3 == NULL || (phys >> 36) != 0 || (phys & 0xfff) != 0) {
+		return false;
+	}
+	l3[(address >> 12) & 511] = phys | A71GPU_PTE | 3 | (read_only ? A71GPU_PTE_RO : 0);
+	a71gpu.dirty = true;
+	return true;
+}
+
+void
+redwood_gpu_mapped(void)
+{
+	if (a71gpu.dirty) {
+		a71gpu.dirty = false;
+		(void)a71gpu_tlbi();
+	}
+}
+
+void
+redwood_gpu_unmap(uint64_t address, uint64_t size)
+{
+	for (uint64_t off = 0; off < size; off += 0x1000) {
+		volatile uint64_t *l3 = a71gpu_l3(address + off, false);
+		if (l3 != NULL) {
+			l3[((address + off) >> 12) & 511] = 0;
+		}
+	}
+	(void)a71gpu_tlbi();
+}
+
+void
+redwood_gpu_to_memory(void *start, uint64_t size)
+{
+	if (start != NULL && size != 0) {
+		FlushPoC_DcacheRegion((vm_offset_t)start, (size_t)size);   /* clean and invalidate */
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* ccu invalidate, the ibs, then the fence (Linux a6xx_submit). 0: ring full */
+uint32_t
+redwood_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint32_t fence = 0;
+
+	if (!a71gpu.redwood) {
+		return 0;
+	}
+	IOLockLock(a71gpu.lock);
+	if (a71gpu_room(4 + 4 * count + 5)) {
+		a71gpu_event(24, false);        /* PC_CCU_INVALIDATE_DEPTH */
+		a71gpu_event(25, false);        /* PC_CCU_INVALIDATE_COLOR */
+		for (uint32_t i = 0; i < count; i++) {
+			a71gpu_pkt7(0x3f, 3);   /* CP_INDIRECT_BUFFER_PFE */
+			a71gpu_out((uint32_t)addresses[i]);
+			a71gpu_out((uint32_t)(addresses[i] >> 32));
+			a71gpu_out(words[i]);
+		}
+		fence = a71gpu_fence();
+		a71gpu_kick();
+	}
+	IOLockUnlock(a71gpu.lock);
+	return fence;
+}
+
+bool
+redwood_gpu_done(uint32_t fence)
+{
+	return a71gpu.ready && (int32_t)(*a71gpu_scr(A71GPU_FENCE) - fence) >= 0;
+}
