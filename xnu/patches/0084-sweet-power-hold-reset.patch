diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index a148608..276a284 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -90,6 +90,22 @@ keys_wait(void)
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
+/*
+ * a71: power held 3 s, or boot-arg sweetreboot=<s> after that many seconds,
+ * does a psci system reset. the a71 shim already set the reboot reason to
+ * recovery, a forced pmic reset (power + vol down) ignores it
+ */
+static void
+keys_reset(const char *why)
+{
+	printf("SWEET KEYS: %s, psci system reset\n", why);
+	register uint64_t x0 __asm__("x0") = 0x84000009ULL;
+	__asm__ volatile("smc #0" : "+r"(x0) : :
+	    "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+	    "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	printf("SWEET KEYS: psci system reset returned %#llx\n", x0);
+}
+
 static void
 keys_thread(void *arg, wait_result_t result)
 {
@@ -97,6 +113,11 @@ keys_thread(void *arg, wait_result_t result)
 	unsigned errors = 0;
 	(void)arg;
 	(void)result;
+	uint32_t reboot_s = 0;
+	uint64_t reboot_at = 0, power_at = 0;
+	if (PE_parse_boot_argn("sweetreboot", &reboot_s, sizeof(reboot_s)) && reboot_s) {
+		clock_interval_to_deadline(reboot_s, NSEC_PER_SEC, &reboot_at);
+	}
 	for (;;) {
 		uint8_t pon = 0, gpio = 0;
 		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
@@ -116,8 +137,24 @@ keys_thread(void *arg, wait_result_t result)
 				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio4:c110=%#x\n",
 				    k, state[k], pon, gpio);
 				sweet_hid_key(k, state[k]);
+				if (k == 0) {
+					power_at = 0;
+					if (state[0]) {
+						clock_interval_to_deadline(3, NSEC_PER_SEC, &power_at);
+					}
+				}
 			}
 		}
+		uint64_t t;
+		clock_get_uptime(&t);
+		if (power_at && t >= power_at) {
+			power_at = 0;
+			keys_reset("power held 3 s");
+		}
+		if (reboot_at && t >= reboot_at) {
+			reboot_at = 0;
+			keys_reset("sweetreboot timer");
+		}
 		keys_wait();
 	}
 }
