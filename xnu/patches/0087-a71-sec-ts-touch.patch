diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 1981490..0f983c1 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -4,6 +4,7 @@
  * No interrupt clear, peripheral enable, charger config, or PMIC writes.
  * Init is serialized by the single built-in SweetBattery personality.
  * Battery APIDs are disjoint from the existing keys' 008/4c1 APIDs.
+ * a71: sweet_spmi_write is the one write path, pm6150 gpio4 (touch dvdd) only.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -17,9 +18,11 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 #define SP_CORE_PA 0x0c440000u
 #define SP_OBS_PA  0x0e600000u
 #define SP_CFG_PA  0x0c40a000u
+#define SP_CHNL_PA 0x0c600000u /* v5 write channels, 0x10000 per apid */
+#define SP_A71_DVDD 0xc3u     /* pm6150 gpio4 */
 #define SP_NO_APID 0xffffu
 
-static vm_offset_t sp_core, sp_obs, sp_cfg;
+static vm_offset_t sp_core, sp_obs, sp_cfg, sp_chnl;
 static IOLock *sp_lock;
 static unsigned sp_count;
 static bool sp_attempted, sp_ready;
@@ -90,7 +93,7 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	unsigned peripheral = addr >> 8;
 	if (!sp_ready || !out || sid != 0 || addr > 0xffffu ||
 	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
-	    peripheral != 0x13 && peripheral != 0x48)) {
+	    peripheral != 0x13 && peripheral != 0x48 && peripheral != SP_A71_DVDD)) {
 		return -1;
 	}
 	IOLockLock(sp_lock);
@@ -123,4 +126,43 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	IOLockUnlock(sp_lock);
 	return -1;
 }
+
+/* ext_writel one byte on the apps-owned channel, like linux spmi-pmic-arb v5 */
+int
+sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val)
+{
+	if (!sp_ready || sid != 0 || (addr >> 8) != SP_A71_DVDD) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid(SP_A71_DVDD);
+	if (apid == SP_NO_APID || sp_poisoned[apid] ||
+	    (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u) != 0) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	if (!sp_chnl) {
+		sp_chnl = ml_io_map(SP_CHNL_PA + 0x10000u * apid, 0x1000);
+	}
+	if (!sp_chnl) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_chnl + 0x10u) = val; /* wdata0 */
+	*(volatile uint32_t *)sp_chnl = (addr & 0xffu) << 4; /* opcode 0, bc 0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_chnl, 0x08u);
+		if (status & 1u) {
+			IOLockUnlock(sp_lock);
+			return (status & 0x0eu) ? -1 : 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET TOUCH: SPMI write timeout addr=%#x APID=%u disabled\n", addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
