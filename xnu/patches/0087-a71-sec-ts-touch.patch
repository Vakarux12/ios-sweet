+/* sec_ts / s6sy761 events: 8 bytes, eid 0 = coordinate, 1-based id, 0..res axes */
+static int
+touch_sects(void)
+{
+	uint8_t buf[88];
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	uint32_t mask = st.active;
+	int err = touch_read(A71_TS_ADDR, 0x60, false, buf, 8); /* read one event */
+	if (err) {
+		return err;
+	}
+	unsigned left = buf[7] & 0x3fu;
+	if (!buf[0]) {
+		return 0;
+	}
+	if (left > 10) {
+		const uint8_t clear = 0x62; /* clear event stack, like the vendor driver */
+		(void)touch_msg(A71_TS_ADDR, &clear, 1, NULL, 0, false);
+		return EIO;
+	}
+	if (left) {
+		err = touch_read(A71_TS_ADDR, 0x61, false, buf + 8, left * 8u);
+		if (err) {
+			return err;
+		}
+	}
+	memcpy(x, st.x, sizeof(x));
+	memcpy(y, st.y, sizeof(y));
+	for (unsigned i = 0; i <= left; ++i) {
+		const uint8_t *ev = buf + 8u * i;
+		if (st.raw_shown < 16) {
+			st.raw_shown++;
+			printf("SWEET TOUCH: ev %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+		}
+		unsigned id = ((ev[0] & 0x3cu) >> 2) - 1u, state = ev[0] >> 6;
+		if ((ev[0] & 3u) || id >= TOUCH_MAX) {
+			continue; /* status or gesture event */
+		}
+		unsigned px = ((unsigned)ev[1] << 4) | (ev[3] >> 4);
+		unsigned py = ((unsigned)ev[2] << 4) | (ev[3] & 15u);
+		px = px * 1080u / st.res_x;
+		py = py * 2400u / st.res_y;
+		if (state == 1 || state == 2) {
+			mask |= 1u << id;
+			x[id] = (int)(px > 1079 ? 1079 : px);
+			y[id] = (int)(py > 2399 ? 2399 : py);
+		} else if (state == 3) {
+			mask &= ~(1u << id);
+		}
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+static void
+touch_a71_dvdd(const char *when)
+{
+	uint8_t sub = 0, mode = 0, src = 0, en = 0;
+	int e = sweet_spmi_read(0, A71_DVDD + 0x05u, &sub) |
+	    sweet_spmi_read(0, A71_DVDD + 0x40u, &mode) |
+	    sweet_spmi_read(0, A71_DVDD + 0x44u, &src) |
+	    sweet_spmi_read(0, A71_DVDD + 0x46u, &en);
+	printf("SWEET TOUCH: a71 %s: avdd gpio56 cfg=%#x io=%#x, dvdd gpio4 err=%d sub=%#x mode=%#x src=%#x en=%#x\n",
+	    when, touch_rd(st.avdd, 0), touch_rd(st.avdd, 4), e, sub, mode, src, en);
+}
+
+/* power only if the ic is silent, then the s8 start sequence */
+static bool
+touch_a71_start(void)
+{
+	uint8_t boot = 0, id[3] = {0}, info[4] = {0}, fw = 0;
+	st.avdd = ml_io_map(A71_AVDD_PA, 0x1000);
+	if (!st.avdd || sweet_spmi_init()) {
+		printf("SWEET TOUCH: a71 no gpio56 map or spmi\n");
+		return false;
+	}
+	touch_gpio(9, 0, 0, 0, false, false); /* attn input, no pull, as in the dt */
+	touch_a71_dvdd("before");
+	st.probing = true;
+	int err = touch_read(A71_TS_ADDR, 0x55, false, &boot, 1); /* boot status */
+	st.probing = false;
+	if (err || boot != 0x20) {
+		printf("SWEET TOUCH: a71 sec_ts silent (err=%d boot=%#x), powering avdd then dvdd\n",
+		    err, boot);
+		/* gpio56 out high, latch before output enable, no pull, 2 mA */
+		touch_wr(st.avdd, 4, touch_rd(st.avdd, 4) | 2u);
+		touch_wr(st.avdd, 0, (touch_rd(st.avdd, 0) & ~0x3ffu) | 0x200u);
+		touch_wait(5);
+		/* linux pinctrl-spmi-gpio lv/mv order: mode out, source high, enable */
+		if (sweet_spmi_write(0, A71_DVDD + 0x40u, 0x01) ||
+		    sweet_spmi_write(0, A71_DVDD + 0x44u, 0x80) ||
+		    sweet_spmi_write(0, A71_DVDD + 0x46u, 0x80)) {
+			printf("SWEET TOUCH: a71 dvdd write failed\n");
+		}
+		touch_a71_dvdd("after");
+		touch_wait(300);
+		st.probing = true;
+		err = touch_read(A71_TS_ADDR, 0x55, false, &boot, 1);
+		st.probing = false;
+	}
+	if (err || boot != 0x20) {
+		printf("SWEET TOUCH: a71 sec_ts not in app mode (err=%d boot=%#x); stopping\n",
+		    err, boot);
+		return false;
+	}
+	(void)touch_read(A71_TS_ADDR, 0x52, false, id, sizeof(id));
+	(void)touch_read(A71_TS_ADDR, 0x21, false, &fw, 1);
+	(void)touch_read(A71_TS_ADDR, 0x23, false, info, sizeof(info));
+	st.res_x = touch_be16(info);
+	st.res_y = touch_be16(info + 2);
+	if (st.res_x < 256 || st.res_x > 8192 || st.res_y < 256 || st.res_y > 8192) {
+		st.res_x = st.res_y = 4096; /* dt sec,max_coords */
+	}
+	const uint8_t func[3] = {0x30, 0x01, 0x00}, sense = 0x10;
+	err = touch_msg(A71_TS_ADDR, func, sizeof(func), NULL, 0, false);
+	if (!err) {
+		err = touch_msg(A71_TS_ADDR, &sense, 1, NULL, 0, false);
+	}
+	printf("SWEET TOUCH: a71 sec_ts id %02x%02x%02x fw-integrity %#x panel %ux%u, sense on err=%d\n",
+	    id[0], id[1], id[2], fw, st.res_x, st.res_y, err);
+	return !err;
+}
