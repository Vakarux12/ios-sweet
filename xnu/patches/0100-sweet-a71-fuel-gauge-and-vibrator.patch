diff --git a/bsd/dev/sweet_haptic.c b/bsd/dev/sweet_haptic.c
new file mode 100644
index 0000000..00472c4
--- /dev/null
+++ b/bsd/dev/sweet_haptic.c
@@ -0,0 +1,145 @@
+/*
+ * a71 vibration: a coin motor on the pm6150 vibrator ldo (spmi sid 1 at 0x5300), at the
+ * 3.3 V android sets. iOS plays its haptics as samples of one channel on its "Actuator",
+ * which topaz's audio plug-in (userland audio_plugin.c) writes to /dev/redwood-haptic.
+ * the motor runs while they are not silence, at least MIN_ON_US so a tap spins it up,
+ * at most MAX_ON_US and then it rests as long. boot-arg sweethaptic=1
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include "sweet_spmi.h"
+
+void sweet_haptic_start(void);
+
+#define VIB_STATUS1   0x5308u /* bit 7: ldo ready */
+#define VIB_VSET_LB   0x5340u /* mV, low byte first */
+#define VIB_EN_CTL    0x5346u /* bit 7: on */
+#define SILENT_BELOW  256u    /* of 32768, as topaz */
+#define QUIET_US      30000u  /* this long without sound and iOS has stopped */
+#define MIN_ON_US     40000u
+#define MAX_ON_US     1000000u
+
+static volatile uint64_t heard_us;
+
+static uint64_t
+now_us(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_USEC;
+}
+
+/* from the audio server's io thread: never waits */
+static int
+haptic_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t samples[256];
+	int error = 0;
+	while (uio_resid(uio) >= 2) {
+		user_ssize_t bytes = uio_resid(uio);
+		if (bytes > (user_ssize_t)sizeof(samples)) {
+			bytes = sizeof(samples);
+		}
+		bytes &= ~(user_ssize_t)1;
+		if ((error = uiomove((caddr_t)samples, (int)bytes, uio)) != 0) {
+			break;
+		}
+		for (unsigned i = 0; i < bytes / 2; i++) {
+			if (samples[i] > (int)SILENT_BELOW || samples[i] < -(int)SILENT_BELOW) {
+				heard_us = now_us();
+				break;
+			}
+		}
+	}
+	return error;
+}
+
+static int
+haptic_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static const struct cdevsw haptic_cdevsw = {
+	.d_open = haptic_open, .d_close = haptic_open, .d_read = eno_rdwrt, .d_write = haptic_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static bool
+motor(bool on)
+{
+	return sweet_spmi_write(1, VIB_EN_CTL, on ? 0x80 : 0) == 0;
+}
+
+static void
+haptic_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	uint64_t since = 0, rest_until = 0;
+	unsigned played = 0;
+	bool on = false;
+	int major;
+	if (sweet_spmi_init() || !motor(false) || sweet_spmi_write(1, VIB_VSET_LB, 0xe4) ||
+	    sweet_spmi_write(1, VIB_VSET_LB + 1, 0x0c)) {
+		printf("SWEET HAPTIC: the vibrator ldo does not take writes\n");
+		return;
+	}
+	major = cdevsw_add(-1, &haptic_cdevsw);
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666,
+	    "redwood-haptic") == NULL) {
+		printf("SWEET HAPTIC: /dev/redwood-haptic cannot be made\n");
+		return;
+	}
+	printf("SWEET HAPTIC: the motor follows /dev/redwood-haptic, 3300 mV\n");
+	for (;;) {
+		(void)tsleep(&chan, PZERO, "sweetvib", 1);
+		uint64_t now = now_us();
+		bool sound = heard_us != 0 && now - heard_us < QUIET_US;
+		if (!on && sound && now >= rest_until) {
+			if (!motor(true)) {
+				break;
+			}
+			on = true;
+			since = now;
+			if (++played <= 10) {
+				uint8_t status = 0;
+				(void)sweet_spmi_read(1, VIB_STATUS1, &status);
+				printf("SWEET HAPTIC: %u on, ldo status %#x\n", played, status);
+			}
+		} else if (on && ((!sound && now - since >= MIN_ON_US) || now - since >= MAX_ON_US)) {
+			bool cut = now - since >= MAX_ON_US;
+			if (cut) {
+				rest_until = now + MAX_ON_US;
+			}
+			if (!motor(false)) {
+				break;
+			}
+			on = false;
+			if (played <= 10) {
+				printf("SWEET HAPTIC: %u off after %llu ms%s\n", played, (now - since) / 1000, cut ? ", cut" : "");
+			}
+		}
+	}
+	(void)motor(false);
+	printf("SWEET HAPTIC: spmi write failed, the motor is given up on\n");
+}
+
+void
+sweet_haptic_start(void)
+{
+	thread_t thread;
+	uint32_t want = 0;
+	if (PE_parse_boot_argn("sweethaptic", &want, sizeof(want)) && want == 1 &&
+	    kernel_thread_start(haptic_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
